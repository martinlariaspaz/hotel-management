NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:2000,http://127.0.0.1:2000,http://localhost:5173,http://localhost:3000

MONGODB_URI=mongodb://localhost:27017/hotel-management
MONGODB_DB=hotel-management
MONGODB_AUTH_SOURCE=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Hotel Management <no-reply@example.com>"

AUTH_JWT_SECRET=change-this-secret
AUTH_TOKEN_TTL_SECONDS=604800
